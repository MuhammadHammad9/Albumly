# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Everything here ends up in the browser, so only PUBLIC values belong here.
# Leave both empty to run without accounts (the library stays in this browser).

# Supabase Project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable key (sb_publishable_... or the legacy anon key). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
