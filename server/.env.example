# Copy this file to .env and fill it in. .env is git-ignored and must never be committed.

# Local API port. In production the host's PORT variable is used instead.
API_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# mock = bundled fictional catalogue (no Spotify account needed), spotify = live Spotify Web API
CATALOG_PROVIDER=mock

# From the Spotify Developer Dashboard -> your app -> Settings. Needed for CATALOG_PROVIDER=spotify
# and for `npm run spike`. The app owner needs an active Spotify Premium subscription.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional two-letter country code (e.g. US, GB, PK). Limits results to releases available in that
# country, which also removes duplicate regional copies of the same album. Leave empty for all markets.
SPOTIFY_MARKET=

# Most Spotify requests the recommendation, graph and calendar lookups may spend per day (UTC). Optional, default 30.
INTELLIGENCE_DAILY_REQUESTS=30

# Caps on real Spotify requests per 10 minutes: for one visitor, and for everyone together.
# They stop one person (or a script) from spending the whole Spotify allowance. Cached answers
# are free and not counted. Optional, defaults 120 and 600.
SPOTIFY_REQUESTS_PER_VISITOR=120
SPOTIFY_REQUESTS_OVERALL=600

# ---------- Accounts (Supabase) ----------
# Optional. Leave all of these empty and the app runs without accounts (library kept in the browser).
# Where to find each value: docs/plans/phase-5-plan.md §10. Never commit real values.

# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Public key (sb_publishable_... or the legacy anon key). Used by `npm run live-check`.
SUPABASE_PUBLISHABLE_KEY=
# SECRET. Server only (sb_secret_... or the legacy service_role key). Used to delete accounts.
SUPABASE_SECRET_KEY=

# off = Albumly's server creates accounts already confirmed, so sign-up needs no email.
# Supabase's built-in email sender allows only a few emails an hour. Leave empty to keep
# Supabase's confirmation emails (set up your own SMTP sender in Supabase first).
SIGNUP_EMAIL_CONFIRMATION=
# SECRET. Connect -> Connection string -> Session pooler, with your database password filled in.
DATABASE_URL=
# Path (relative to server/) of the CA certificate from Project Settings -> Database -> SSL Configuration
DATABASE_SSL_CA=certs/supabase-ca.crt

# When hosted behind a proxy (most platforms): how many proxies sit in front of the API, usually 1
TRUST_PROXY=
